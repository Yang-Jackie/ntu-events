{
  "name": "@ntu-events/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/generated/schema.d.ts",
    "generated:check": "openapi-typescript openapi.json --output src/generated/schema.d.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3"
  }
}
